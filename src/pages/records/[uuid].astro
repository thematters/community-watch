---
import PageLayout from "../../layouts/PageLayout.astro";
import { page } from "../../content/page";
import { getCommunityWatchActionData } from "../../content/communityWatchData";

const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, string | undefined> } })
  .runtime?.env;
const uuid = Astro.params.uuid ?? "";
const watchCase = await getCommunityWatchActionData(uuid, runtimeEnv);
const baseUrl = import.meta.env.BASE_URL;
const title = watchCase
  ? `${watchCase.commentId}｜${page.hero.title}`
  : `公開紀錄不存在｜${page.hero.title}`;
const description = watchCase
  ? `守望相助隊公開紀錄：${watchCase.commentId}，處理理由為${watchCase.reason}。`
  : "守望相助隊公開紀錄頁。這筆紀錄目前無法於公開 API 查詢。";
const mailSubject = encodeURIComponent(
  `守望相助隊申訴：${watchCase?.commentId ?? uuid}`
);
const reasonVariant = watchCase?.reason === "色情廣告" ? "adult" : "spam";
const reviewTone =
  watchCase?.reviewStatus === "已恢復"
    ? "positive"
    : watchCase?.reviewStatus === "待覆核"
      ? "pending"
      : "neutral";
const appealTone = watchCase?.appealStatus === "未申訴" ? "muted" : "pending";
const reviewSummary =
  watchCase?.reviewStatus === "已恢復"
    ? "站方已恢復留言"
    : watchCase?.reviewStatus === "維持處理"
      ? "站方維持原處理"
      : watchCase?.reviewStatus === "理由已調整"
        ? "站方已調整理由"
        : "等待站方覆核";

Astro.response.headers.set("cache-control", "no-store");
---

<PageLayout
  title={title}
  description={description}
  lang={page.lang}
>
  <div class="page">
    <header class="page__header">
      <a class="page__brand" href={baseUrl}>
        <img src={`${baseUrl}matters-lettering-black.svg`} alt="Matters" />
        <span aria-hidden="true"></span>
        <strong>守望相助隊</strong>
      </a>
      <nav class="page__nav" aria-label="主要導覽">
        <a href={`${baseUrl}#watch-log`}>處理紀錄</a>
        <a href={`${baseUrl}#appeal`}>申訴</a>
        <a href="https://matters.town/billboard">Billboard</a>
      </nav>
    </header>

    <main class="record-main">
      <a class="back-link" href={watchCase ? `${baseUrl}#case-${watchCase.id}` : baseUrl}>
        回到處理紀錄
      </a>

      {
        watchCase ? (
          <article class="record board">
            <header class="record__hero">
              <div class="record__hero-copy">
                <p class="record__kicker">
                  <span>公開紀錄</span>
                  <span>{watchCase.sourceType}</span>
                  <span>{watchCase.reason}</span>
                </p>
                <h1 class="record-title">{watchCase.sourceTitle}</h1>
                <p class="record__summary">
                  {watchCase.handledAt} · 由 {watchCase.watcher} 處理
                </p>
              </div>
              <dl class="decision-card" aria-label="處理狀態">
                <div class={`decision-card__primary decision-card__primary--${reviewTone}`}>
                  <dt>站方覆核</dt>
                  <dd>{watchCase.reviewStatus}</dd>
                </div>
                <div>
                  <dt>申訴狀態</dt>
                  <dd><span class={`status-text status-text--${appealTone}`}>{watchCase.appealStatus}</span></dd>
                </div>
              </dl>
            </header>

            <section class="decision-strip" aria-label="快速判讀">
              <div class="decision-strip__notice">
                <span aria-hidden="true"></span>
                <div>
                  <strong>{watchCase.publicNotice}</strong>
                  <p>{reviewSummary}</p>
                </div>
              </div>
              <dl class="decision-strip__meta">
                <div>
                  <dt>處理理由</dt>
                  <dd><span class={`reason reason--${reasonVariant}`}>{watchCase.reason}</span></dd>
                </div>
                <div>
                  <dt>來源類型</dt>
                  <dd>{watchCase.sourceType}</dd>
                </div>
                <div>
                  <dt>原處替換</dt>
                  <dd>已顯示</dd>
                </div>
              </dl>
            </section>

            <div class="record-layout">
              <div class="record-layout__main">
                <section class="record-section content-box" aria-labelledby="original-content">
                  <div class="content-box__header">
                    <div class="section-heading">
                      <p class="eyebrow">原文檢視</p>
                      <h2 id="original-content">原留言內容</h2>
                    </div>
                    <button
                      class="btn btn--ghost content-box__toggle"
                      type="button"
                      data-watch-toggle
                      aria-expanded="false"
                    >
                      顯示全文
                    </button>
                  </div>
                  <p class="content-box__body is-blurred" data-watch-body>{watchCase.commentPreview}</p>
                  <p class="content-box__hint">
                    原文預設遮蔽，避免垃圾內容被二次散播；點開僅供申訴、覆核與社群稽核使用。
                  </p>
                </section>

                <section class="record-section context-panel" aria-labelledby="context-title">
                  <div class="section-heading">
                    <p class="eyebrow">處理脈絡</p>
                    <h2 id="context-title">來源與處理資訊</h2>
                  </div>
                  <dl class="context-list">
                    <div>
                      <dt>來源標題</dt>
                      <dd>{watchCase.sourceTitle}</dd>
                    </div>
                    <div>
                      <dt>處理人</dt>
                      <dd>{watchCase.watcher}</dd>
                    </div>
                    <div>
                      <dt>處理時間</dt>
                      <dd>{watchCase.handledAt}</dd>
                    </div>
                  </dl>
                </section>
              </div>

              <aside class="record-layout__side" aria-label="稽核與申訴">
                <section class="side-panel audit-box" aria-labelledby="audit-title">
                  <div class="section-heading">
                    <p class="eyebrow">稽核資訊</p>
                    <h2 id="audit-title">查詢用 ID</h2>
                  </div>
                  <dl class="audit-list">
                    <div>
                      <dt>公開紀錄 ID</dt>
                      <dd><code>{watchCase.id}</code></dd>
                    </div>
                    <div>
                      <dt>留言 ID</dt>
                      <dd><code>{watchCase.commentId}</code></dd>
                    </div>
                    <div>
                      <dt>來源 ID</dt>
                      <dd><code>{watchCase.sourceId}</code></dd>
                    </div>
                  </dl>
                </section>

                <section class="side-panel appeal-box" aria-labelledby="appeal-title">
                  <p class="eyebrow">申訴</p>
                  <h2 id="appeal-title">需要覆核？</h2>
                  <p>
                    請將留言 ID <strong>{watchCase.commentId}</strong> 寄至
                    <a href={`mailto:${page.appeal.email}?subject=${mailSubject}`}>{page.appeal.email}</a>。
                    站方會依公開紀錄、處理理由與原文進行覆核。
                  </p>
                </section>
              </aside>
            </div>
          </article>
        ) : (
          <article class="record board">
            <header class="record__hero record__hero--empty">
              <div>
                <p class="eyebrow">公開紀錄</p>
                <h1 class="record-title">找不到這筆公開紀錄</h1>
              </div>
            </header>
            <p class="record__notice">
              這筆紀錄可能尚未同步至公開 API，或已不是有效的守望相助隊處理紀錄。
            </p>
          </article>
        )
      }

      {!watchCase && (
        <aside class="appeal-box board" aria-labelledby="appeal-title">
          <p class="eyebrow">申訴</p>
          <h2 id="appeal-title">認為這則留言被誤判？</h2>
          <p>
            請將留言 ID <strong>{uuid}</strong> 寄至
            <a href={`mailto:${page.appeal.email}?subject=${mailSubject}`}>{page.appeal.email}</a>。
            站方會依公開紀錄、處理理由與原文進行覆核。
          </p>
        </aside>
      )}
    </main>

    <footer class="page__footer">
      <div class="page__footer-copy">
        <span>{page.footer.note}</span>
        <strong>{page.footer.warning}</strong>
      </div>
    </footer>
  </div>
</PageLayout>

<script>
  document.querySelectorAll("[data-watch-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const content = button.closest(".content-box")?.querySelector("[data-watch-body]");
      const isExpanded = button.getAttribute("aria-expanded") === "true";

      content?.classList.toggle("is-blurred", isExpanded);
      button.setAttribute("aria-expanded", String(!isExpanded));
      button.textContent = isExpanded ? "顯示全文" : "收起全文";
    });
  });
</script>

<style>
  .record-main {
    width: 100%;
    max-width: var(--board-max);
    margin: 0 auto;
    padding: var(--space-watch-24) var(--board-pad-x) var(--space-watch-48);
    display: grid;
    gap: var(--space-sp16);
  }

  .back-link {
    color: var(--ink-muted);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--brand-purple);
  }

  .record__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    align-items: start;
    gap: var(--space-watch-24);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-watch-24);
  }

  .record__hero-copy {
    min-width: 0;
  }

  .record__kicker {
    margin: 0 0 var(--space-sp10);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sp8);
    color: var(--ink-muted);
    font-size: 14px;
    font-weight: 800;
  }

  .record__kicker span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sp8);
  }

  .record__kicker span + span::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--line);
  }

  .record h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 32px;
    font-weight: 600;
    line-height: 54px;
    letter-spacing: 1.2px;
    overflow-wrap: anywhere;
  }

  .record__summary {
    margin: var(--space-sp10) 0 0;
    color: var(--ink-muted);
    font-size: 15px;
    font-weight: 600;
  }

  .decision-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
    overflow: hidden;
  }

  .decision-card div {
    padding: var(--space-sp14) var(--space-sp16);
    border-bottom: 1px solid var(--line);
  }

  .decision-card div:last-child {
    border-bottom: 0;
  }

  .decision-card dt,
  .decision-strip__meta dt,
  .context-list dt,
  .audit-list dt {
    margin: 0;
    color: var(--ink-muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
  }

  .decision-card dd,
  .decision-strip__meta dd,
  .context-list dd,
  .audit-list dd {
    margin: var(--space-sp4) 0 0;
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    overflow-wrap: anywhere;
  }

  .decision-card__primary dd {
    font-size: 20px;
    line-height: 30px;
  }

  .decision-card__primary--positive {
    background: var(--color-secondary-0);
  }

  .decision-card__primary--pending {
    background: var(--surface-purple);
  }

  .decision-card__primary--neutral {
    background: var(--board-bg);
  }

  .decision-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
    margin-top: var(--space-watch-24);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--board-bg);
    overflow: hidden;
    align-items: start;
  }

  .decision-strip__notice {
    display: flex;
    gap: var(--space-sp14);
    align-items: flex-start;
    min-height: 100%;
    padding: var(--space-sp16);
  }

  .decision-strip__notice > span {
    width: 4px;
    align-self: stretch;
    min-height: 76px;
    border-radius: 999px;
    background: var(--brand-lime);
  }

  .decision-strip__notice strong {
    display: block;
    color: var(--ink);
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
  }

  .decision-strip__notice p {
    margin: var(--space-sp4) 0 0;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .decision-strip__meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-height: 100%;
    border-left: 1px solid var(--line);
    background: var(--surface-muted);
  }

  .decision-strip__meta div {
    min-width: 0;
    padding: var(--space-sp16);
    border-right: 1px solid var(--line);
  }

  .decision-strip__meta div:last-child {
    border-right: 0;
  }

  .reason {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .reason--adult {
    background: var(--adult-bg);
    color: var(--adult-ink);
  }

  .reason--spam {
    background: var(--spam-bg);
    color: var(--spam-ink);
  }

  .record-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
    gap: var(--space-watch-24);
    margin-top: var(--space-watch-24);
    align-items: start;
  }

  .record-layout__main {
    min-width: 0;
  }

  .record-layout__side {
    display: grid;
    gap: var(--space-sp16);
    min-width: 0;
  }

  .side-panel,
  .context-list,
  .audit-list {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--board-bg);
  }

  .side-panel {
    padding: var(--space-sp16);
  }

  .context-list div,
  .audit-list div {
    min-width: 0;
    padding: var(--space-sp14) var(--space-sp16);
    border-bottom: 1px solid var(--line);
  }

  .context-list div:last-child,
  .audit-list div:last-child {
    border-bottom: 0;
  }

  .status-text {
    color: var(--ink);
  }

  .status-text--positive {
    color: var(--color-function-positive-dark, #0d7a3f);
  }

  .status-text--pending {
    color: var(--brand-purple);
  }

  .status-text--muted {
    color: var(--ink-muted);
  }

  .record-section {
    margin-top: 0;
  }

  .section-heading {
    margin-bottom: var(--space-sp12);
  }

  .section-heading h2,
  .content-box__header {
    margin: 0;
  }

  .section-heading h2,
  .appeal-box h2,
  .side-panel h2 {
    font-family: var(--font-ui);
    font-size: 20px;
    font-weight: 600;
    line-height: 30px;
  }

  .section-heading h2 {
    margin: 0;
  }

  .context-list {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(160px, 0.4fr) minmax(180px, 0.5fr);
  }

  .context-list div {
    border-bottom: 0;
    border-right: 1px solid var(--line);
  }

  .context-list div:last-child {
    border-right: 0;
  }

  .content-box__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sp12);
  }

  .content-box__body {
    min-height: 172px;
    margin: var(--space-sp12) 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
    padding: var(--space-sp16);
    transition: filter 0.16s ease, opacity 0.16s ease;
  }

  .content-box__body.is-blurred {
    filter: blur(7px);
    opacity: 0.56;
    user-select: none;
  }

  .content-box__toggle {
    font-size: 14px;
    line-height: 22px;
    min-height: 40px;
    padding: var(--space-sp8) var(--space-sp16);
  }

  .content-box__hint,
  .appeal-box p {
    color: var(--ink-muted);
  }

  .audit-list code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    white-space: normal;
    word-break: break-all;
  }

  .appeal-box a {
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .record__hero,
    .decision-strip,
    .record-layout {
      grid-template-columns: 1fr;
    }

    .decision-strip__meta {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .context-list {
      grid-template-columns: 1fr;
    }

    .context-list div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .context-list div:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .record__hero {
      display: grid;
    }

    .decision-strip__meta {
      grid-template-columns: 1fr;
    }

    .decision-strip__meta div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .decision-strip__meta div:last-child {
      border-bottom: 0;
    }

    .content-box__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .record h1 {
      font-size: 24px;
      line-height: 36px;
    }
  }
</style>
