{
  "name": "@matters/community-watch",
  "version": "0.0.0",
  "private": true,
  "description": "Public transparency page for Matters Community Watch.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,json,md,css}\"",
    "lint": "pnpm format:check && pnpm typecheck",
    "lint:fix": "pnpm format",
    "preview": "pnpm build && wrangler pages dev dist --compatibility-date=2026-05-07 --port 4321",
    "staging:check": "node scripts/staging-check.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/cloudflare": "10.4.2",
    "astro": "4.16.18",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "prettier-plugin-astro": "^0.14.1"
  }
}
